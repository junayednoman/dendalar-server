generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Auth {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  role               UserRole
  status             UserStatus          @default(PENDING)
  loginProvider      LoginProvider
  fcmToken           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  otp                OTP?
  profile            Profile?
  userProfile        UserProfile?
  completedLevels    CompletedLevel[]
  completedChapters  CompletedChapter[]
  completedLessons   CompletedLesson[]
  completedQuestions CompletedQuestion[]

  @@map("auth")
}

model OTP {
  id                String     @id @default(uuid())
  authId            String     @unique
  otp               String
  expires           DateTime
  attempts          Int        @default(0)
  isVerified        Boolean    @default(false)
  createdAt         DateTime   @default(now())
  purpose           OTPPurpose
  resetTokenExpires DateTime?
  resetTokenHash    String?
  auth              Auth       @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@unique([authId, purpose])
  @@map("otp")
}

model Profile {
  id        String   @id @default(uuid())
  authId    String   @unique
  name      String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auth      Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserProfile {
  id             String         @id @default(uuid())
  authId         String         @unique
  auth           Auth           @relation(fields: [authId], references: [id], onDelete: Cascade)
  purpose        UserPurpose
  referralSource ReferralSource
  age            Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Level {
  id              String           @id @default(uuid())
  name            String           @unique
  index           Int              @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  chapters        Chapter[]
  completedLevels CompletedLevel[]

  @@unique([name, index])
}

model Chapter {
  id                String             @id @default(uuid())
  name              String
  index             Int
  levelId           String
  level             Level              @relation(fields: [levelId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  questions         Question[]
  completedChapters CompletedChapter[]

  @@unique([levelId, index])
}

model Lesson {
  id               String            @id @default(uuid())
  name             String            @unique
  icon             String
  index            Int               @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  questions        Question[]
  completedLessons CompletedLesson[]
}

model Question {
  id                         String              @id @default(uuid())
  chapterId                  String
  chapter                    Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessonId                   String
  lesson                     Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sentenceInEnglish          String?
  sentenceInLearningLanguage String?
  hint                       String?
  fullSentence               String?
  missingWord                String?
  index                      Int
  type                       QuestionType
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  completedQuestions         CompletedQuestion[]

  @@unique([index, type, chapterId, lessonId])
}

model CompletedLevel {
  id        String   @id @default(uuid())
  authId    String
  auth      Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
  levelId   String
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompletedChapter {
  id        String   @id @default(uuid())
  authId    String
  auth      Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompletedLesson {
  id        String   @id @default(uuid())
  authId    String
  auth      Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompletedQuestion {
  id         String   @id @default(uuid())
  authId     String
  auth       Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Legal {
  id             String   @id @default(uuid())
  privacyPolicy  String
  termsCondition String
  aboutUs        String
  updatedAt      DateTime @updatedAt
}

enum ReferralSource {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  OTHER
}

enum UserPurpose {
  JUST_FOR_FUN
  BOOST_CAREER
  CONNECT_WITH_PEOPLE
  HIGHER_EDUCATION
  OTHER
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum LoginProvider {
  EMAIL
  GOOGLE
}

enum UserRole {
  ADMIN
  USER
}

enum OTPPurpose {
  VERIFY_ACCOUNT
  RESET_PASSWORD
}

enum QuestionType {
  SENTENCE
  DIALOGUE
}
